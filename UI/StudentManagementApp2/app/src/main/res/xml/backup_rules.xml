<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Student records and authentication state are intentionally not backed
         up to consumer cloud storage. The server database is the source of
         truth, and the local cache contains sensitive student information. -->
    <exclude domain="sharedpref" path="student_management_data.xml" />
    <exclude domain="sharedpref" path="secure_auth.xml" />
</full-backup-content>
